cat > /Users/abhinav/Desktop/maneuver-voice/.gitignore << 'EOF'
# Environment files - NEVER commit these
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
*.egg-info/

# Node
node_modules/
.next/
.pnpm-store/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
EOF